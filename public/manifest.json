{
  "name": "Tá Resolvido",
  "short_name": "Tá Resolvido",
  "description": "Seu mês sob controle. Sem planilha.",
  "start_url": "/app",
  "display": "standalone",
  "background_color": "#EFEAE0",
  "theme_color": "#1F3A3D",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf"] }]
    }
  }
}
